<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are self-hosting executables on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts are shared with the TS test suite; tests read them next to the assembly. -->
    <None Include="..\..\contracts\schemas\*.json" LinkBase="contracts\schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Snapshots\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Terraria.WorldCodec\Terraria.WorldCodec.csproj" />
    <ProjectReference Include="..\Terraria.WorldInspector\Terraria.WorldInspector.csproj" />
  </ItemGroup>

</Project>
