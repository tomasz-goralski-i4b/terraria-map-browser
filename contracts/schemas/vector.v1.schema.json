{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomasz-goralski-i4b/terraria-map-browser/contracts/schemas/vector.v1.schema.json",
  "title": "Metadata and tile vectors v1",
  "description": "A `contracts/vectors/*.vectors.json` file (docs/file-format.md, \"Metadata and tile vectors\"). Hex is the input; offsets are absolute file offsets (context.baseOffset is the offset of the first byte shown). A case carries exactly one of `result` and `error`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "group",
    "vectors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "group": {
      "enum": [
        "metadata",
        "tiles",
        "runs"
      ]
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "entry",
              "context",
              "cases"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "entry": {
                "const": "REC"
              },
              "context": {
                "$ref": "#/$defs/recContext"
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "result"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "result": {
                          "$ref": "#/$defs/recResult"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "error"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "error": {
                          "$ref": "#/$defs/recError"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R5"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R6"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 6
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R7"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 4
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R8"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 4
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "T14"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "T15"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "T16"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 4
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "T17"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "T1",
                      "T2",
                      "T3",
                      "T4",
                      "T5",
                      "T6",
                      "T7",
                      "T8",
                      "T9",
                      "T10",
                      "T11",
                      "T12",
                      "T13",
                      "R1",
                      "R2",
                      "R3",
                      "R4",
                      "M1",
                      "M3"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "entry",
              "context",
              "cases"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "entry": {
                "const": "SEC"
              },
              "context": {
                "$ref": "#/$defs/secContext"
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "result"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "result": {
                          "$ref": "#/$defs/secResult"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "error"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "error": {
                          "$ref": "#/$defs/secError"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R9"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 100,
                              "maximum": 104
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "R10"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 100,
                              "maximum": 108
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "T1",
                      "T2",
                      "T3",
                      "T4",
                      "T5",
                      "T6",
                      "T7",
                      "T8",
                      "T9",
                      "T10",
                      "T11",
                      "T12",
                      "T13",
                      "R1",
                      "R2",
                      "R3",
                      "R4",
                      "M1",
                      "M3"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "entry",
              "context",
              "cases"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "entry": {
                "const": "META"
              },
              "context": {
                "$ref": "#/$defs/metaContext"
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "result"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "result": {
                          "$ref": "#/$defs/metaResult"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hex",
                        "error"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})+$",
                          "description": "Lowercase hex, two digits per byte, no separators."
                        },
                        "error": {
                          "$ref": "#/$defs/metadataError"
                        }
                      }
                    }
                  ]
                }
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            },
            "oneOf": [
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "M2"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 8
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "M4"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "M5"
                  },
                  "cases": {
                    "items": {
                      "properties": {
                        "error": {
                          "properties": {
                            "offset": {
                              "minimum": 0,
                              "maximum": 5
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "T1",
                      "T2",
                      "T3",
                      "T4",
                      "T5",
                      "T6",
                      "T7",
                      "T8",
                      "T9",
                      "T10",
                      "T11",
                      "T12",
                      "T13",
                      "R1",
                      "R2",
                      "R3",
                      "R4",
                      "M1",
                      "M3"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(T([1-9]|1[0-7])|R([1-9]|10)|M[1-5])$"
    },
    "recContext": {
      "description": "REC: one record (or a column prefix, R6) at `position`, column height `columnHeight`; the decoder consumes exactly the bytes shown.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "baseOffset",
        "position",
        "columnHeight",
        "frameImportant"
      ],
      "properties": {
        "formatVersion": {
          "const": 326
        },
        "baseOffset": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "columnHeight": {
          "type": "integer",
          "minimum": 1
        },
        "frameImportant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "frame",
            "plain"
          ],
          "description": "Frame-important set: `k` bits in the header array; `frame` ids that are frame-important, `plain` ids that are not.",
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "frame": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "plain": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "secContext": {
      "description": "SEC: the bytes shown are the whole tile section; `baseOffset` is pointer[1] and pointer[2] = baseOffset + byte count.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "baseOffset",
        "width",
        "height",
        "frameImportant"
      ],
      "properties": {
        "formatVersion": {
          "const": 326
        },
        "baseOffset": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frameImportant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "frame",
            "plain"
          ],
          "description": "Frame-important set: `k` bits in the header array; `frame` ids that are frame-important, `plain` ids that are not.",
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "frame": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "plain": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "metaContext": {
      "description": "META: metadata bytes starting at field `startsAt`; `inputEnd` is the absolute end of the supplied bytes (baseOffset + byte count; a prefix may stop short of the section), `sectionEnd` is the absolute offset of pointer[1] (end of the whole metadata section, >= inputEnd).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "baseOffset",
        "startsAt",
        "inputEnd",
        "sectionEnd"
      ],
      "properties": {
        "formatVersion": {
          "const": 326
        },
        "baseOffset": {
          "type": "integer",
          "minimum": 0
        },
        "startsAt": {
          "enum": [
            "height",
            "bool",
            "name"
          ]
        },
        "inputEnd": {
          "type": "integer",
          "minimum": 1
        },
        "sectionEnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "description": "Where the bytes come from: an existing fixture, never embedded as a full world.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "file",
        "sha256",
        "offset",
        "length"
      ],
      "properties": {
        "world": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contentRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "vanilla"
            },
            "id": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mod",
            "internalName"
          ],
          "properties": {
            "kind": {
              "const": "mod"
            },
            "mod": {
              "type": "string"
            },
            "internalName": {
              "type": "string"
            },
            "runtimeId": {
              "type": "integer"
            },
            "modVersion": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "runtimeId"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "runtimeId": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "tile": {
      "description": "Expected semantic tile (mirrors world-summary.v1 `$defs.tile` minus x and y: the position comes from the vector context; scripts/check-contracts.mjs keeps the two in sync).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wires",
        "actuator"
      ],
      "properties": {
        "block": {
          "$ref": "#/$defs/contentRef"
        },
        "frameX": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "frameY": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "paint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "wall": {
          "$ref": "#/$defs/contentRef"
        },
        "wallPaint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "wires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "actuator": {
          "type": "boolean"
        },
        "liquid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "amount"
          ],
          "properties": {
            "kind": {
              "enum": [
                "water",
                "lava",
                "honey",
                "shimmer"
              ]
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "shape": {
          "enum": [
            "half",
            "slopeTopRight",
            "slopeTopLeft",
            "slopeBottomRight",
            "slopeBottomLeft"
          ]
        },
        "inactive": {
          "const": true
        },
        "invisibleBlock": {
          "const": true
        },
        "invisibleWall": {
          "const": true
        },
        "fullBrightBlock": {
          "const": true
        },
        "fullBrightWall": {
          "const": true
        }
      }
    },
    "recResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tile",
        "run"
      ],
      "properties": {
        "kind": {
          "const": "record"
        },
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "run": {
          "type": "integer"
        }
      }
    },
    "secResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "width",
        "height",
        "tiles"
      ],
      "properties": {
        "kind": {
          "const": "grid"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tile"
          }
        }
      },
      "description": "`tiles` is column-major: index = x * height + y."
    },
    "metaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "metadata"
        },
        "name": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "worldId": {
          "type": "integer"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "properties": {
            "left": {
              "type": "integer"
            },
            "right": {
              "type": "integer"
            },
            "top": {
              "type": "integer"
            },
            "bottom": {
              "type": "integer"
            }
          }
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "gameMode": {
          "type": "integer"
        }
      }
    },
    "metadataError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "offset"
      ],
      "properties": {
        "code": {
          "const": "MalformedMetadata"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "field": {
          "type": "string"
