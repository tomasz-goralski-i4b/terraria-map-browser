{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only entity section vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "group",
    "vectors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "group": {
      "const": "entities"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "section",
          "start",
          "end",
          "hex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "section": {
            "enum": [
              "Chests",
              "Signs",
              "NpcsAndMobs",
              "TileEntities",
              "WeightedPressurePlates",
              "TownManager",
              "Bestiary",
              "CreativePowers"
            ]
          },
          "version": {
            "description": "World format whose entity layout applies; 326 when omitted.",
            "enum": [269, 270, 271, 272, 273, 274, 275, 276, 277, 278, 279, 315, 316, 317, 318, 319, 325, 326]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "hex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$"
          },
          "result": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "offset",
              "reason"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    }
  }
}
